<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xlarge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_large">

        <TextView
            android:id="@+id/txtProfileHeader"
            android:accessibilityHeading="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_profile"
            android:textColor="@color/black"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact"
            android:text="@string/subtitle_profile"
            android:textColor="@color/purple_main"
            android:textSize="@dimen/small_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xsmall"
        android:background="@drawable/light_card_bg"
        android:orientation="vertical"
        android:padding="@dimen/spacing_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="@dimen/element_size_large"
                android:layout_height="@dimen/element_size_large"
                android:src="@drawable/profile"
                android:contentDescription="@string/profile_photo_desc"
                android:scaleType="centerCrop"
                android:layout_marginEnd="@dimen/spacing_large" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/purple_main"
                    android:textSize="@dimen/emphasis_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:textColor="@color/gray_dark"
                    android:textSize="@dimen/small_text_size" />

                <TextView
                    android:id="@+id/txtUserPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xsmall"
                    android:textColor="@color/gray_dark"
                    android:textSize="@dimen/small_text_size"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:backgroundTint="@color/purple_main"
            android:text="@string/btn_edit_profile"
            android:textColor="@color/white" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_thickness"
            android:layout_marginTop="@dimen/spacing_20"
            android:layout_marginBottom="@dimen/spacing_18"
            android:background="@color/gray_light" />

        <LinearLayout
            android:id="@+id/statisticsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="@dimen/stat_icon_container"
                    android:layout_height="@dimen/stat_icon_container"
                    android:background="@drawable/stat_icon_bg">

                    <ImageView
                        android:layout_width="@dimen/stat_icon_size"
                        android:layout_height="@dimen/stat_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fire_active"
                        app:tint="@color/orange"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_regular"
                    android:text="@string/profile_active_rachas_label"
                    android:textColor="@color/gray_light"
                    android:textSize="@dimen/caption_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtActiveRachas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_compact"
                    android:textColor="@color/black"
                    android:textSize="@dimen/emphasis_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/divider_thickness"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:background="@color/gray_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="@dimen/stat_icon_container"
                    android:layout_height="@dimen/stat_icon_container"
                    android:background="@drawable/stat_icon_bg">

                    <ImageView
                        android:layout_width="@dimen/stat_icon_size"
                        android:layout_height="@dimen/stat_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="@color/green"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_regular"
                    android:text="@string/profile_completed_today_label"
                    android:textColor="@color/gray_light"
                    android:textSize="@dimen/caption_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCompletedToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_compact"
                    android:textColor="@color/black"
                    android:textSize="@dimen/emphasis_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/divider_thickness"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:background="@color/gray_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="@dimen/stat_icon_container"
                    android:layout_height="@dimen/stat_icon_container"
                    android:background="@drawable/stat_icon_bg">

                    <ImageView
                        android:layout_width="@dimen/stat_icon_size"
                        android:layout_height="@dimen/stat_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_trophy"
                        app:tint="@color/blue"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_regular"
                    android:text="@string/profile_best_streak_label"
                    android:textColor="@color/gray_light"
                    android:textSize="@dimen/caption_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBestRacha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_compact"
                    android:textColor="@color/black"
                    android:textSize="@dimen/body_text_size"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/profileInspirationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:background="@drawable/light_card_bg"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_inspiration_title"
            android:textColor="@color/purple_main"
            android:textSize="@dimen/small_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtProfileDailyQuote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_compact"
            android:text="@string/profile_quote_loading"
            android:textColor="@color/black"
            android:textSize="@dimen/small_text_size"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/txtProfileDailyQuoteAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:gravity="end"
            android:textColor="@color/gray_dark"
            android:textSize="@dimen/menu_text_size" />

        <TextView
            android:id="@+id/txtProfileQuoteSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:gravity="end"
            android:text="@string/profile_quote_source"
            android:textColor="@color/purple_main"
            android:textSize="@dimen/caption_text_size" />

    </LinearLayout>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:backgroundTint="@color/purple_main"
        android:text="@string/btn_logout"
        android:textColor="@color/white" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginTop="@dimen/spacing_medium"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_small">

        <LinearLayout
            android:id="@+id/menuInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/menu_icon_width"
                android:layout_height="@dimen/menu_icon_height"
                android:src="@drawable/home"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:tint="@color/gray_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_inicio"
                android:textColor="@color/gray_dark"
                android:textSize="@dimen/menu_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuCalendario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/menu_icon_width"
                android:layout_height="@dimen/menu_icon_height"
                android:src="@drawable/calendar"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:tint="@color/gray_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_calendario"
                android:textColor="@color/gray_dark"
                android:textSize="@dimen/menu_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuAmigos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/menu_icon_width"
                android:layout_height="@dimen/menu_icon_height"
                android:src="@drawable/friends"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:tint="@color/gray_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_amigos"
                android:textColor="@color/gray_dark"
                android:textSize="@dimen/menu_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/menu_icon_width"
                android:layout_height="@dimen/menu_icon_height"
                android:src="@drawable/profile"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:tint="@color/gray_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_perfil"
                android:textColor="@color/gray_dark"
                android:textSize="@dimen/menu_text_size"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
