<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    android:background="@drawable/racha_card_bg"
    android:elevation="@dimen/elevation_small"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_regular">

    <TextView
        android:id="@+id/txtRachaIcon"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:gravity="center"
        android:textSize="@dimen/racha_icon_text_size" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtRachaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/section_text_size"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtRachaDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/body_text_size"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgFire"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/spacing_small"
            android:contentDescription="@string/fire_icon"
            android:padding="@dimen/spacing_regular"
            android:src="@drawable/ic_fire_inactive" />

    </LinearLayout>

</LinearLayout>
